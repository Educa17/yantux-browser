{
  "name": "yantux",
  "version": "2.2.0",
  "description": "YANTUX - navegador web pessoal",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": {
    "name": "Educa17",
    "email": "SEU_EMAIL"
  },
  "license": "ISC",
  "homepage": "https://github.com/Educa17/yantux-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/Educa17/yantux-browser.git"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yantux.browser",
    "productName": "YANTUX",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "assets/**",
      "!*backup*",
      "!*.bak*"
    ],
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "linux": {
      "target": ["deb", "rpm", "AppImage"],
      "category": "Network"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0"
  }
}
